{
  "name": "MathArena - Tundra (Difficulty 3)",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$path": "src/StarterGui"
    },

    "Workspace": {
      "$className": "Workspace",
      "$path": "src/Workspace",

      "Arena": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },

      "LobbyIceAge": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": false,
      "$properties": {
        "Ambient": [0.549, 0.549, 0.549],
        "OutdoorAmbient": [0.549, 0.549, 0.549],
        "Brightness": 1.8,
        "ClockTime": 14.0,
        "ExposureCompensation": 0.15,
        "FogColor": [0.588, 0.745, 0.863],
        "FogStart": 100000,
        "FogEnd": 100000
      },

      "LobbyBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Enabled": true,
          "Intensity": 0.35,
          "Threshold": 1.6,
          "Size": 20
        }
      },

      "LobbyColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Enabled": true,
          "Contrast": 0,
          "Saturation": 0.12,
          "Brightness": 0.02,
          "TintColor": [1, 1, 1]
        }
      },

      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.25,
          "Color": [0.78, 0.8, 0.85],
          "Decay": [0.55, 0.6, 0.7],
          "Glare": 0.05,
          "Haze": 0.15
        }
      },

      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Enabled": true,
          "Intensity": 0.01,
          "Spread": 0.1
        }
      },

      "DepthOfField": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "Enabled": true,
          "FarIntensity": 0.05,
          "FocusDistance": 0.05,
          "InFocusRadius": 90,
          "NearIntensity": 0
        }
      }
    }
  }
}
